# Copy to web/.env and adjust. Everything here ends up in the browser bundle:
# PUBLIC values only. Never put a private key in this file.

# Same site as Faras's Wokwi/Unity and the v2 backend (docs/integration-v2.md)
VITE_SITE=ag-sakarya26

# MQTT over WebSocket (browsers cannot open raw TCP on port 1883)
#   public HiveMQ:   wss://broker.hivemq.com:8884/mqtt
#   local broker:    ws://localhost:8080   (tools/sim: npm run broker)
VITE_MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt

# Base Sepolia
VITE_RPC_URL=https://sepolia.base.org
VITE_CHAIN_ID=84532
# v1 contract below; after deploying v2, put ESCROW_V2_ADDRESS and its deploy block here
VITE_ESCROW_ADDRESS=0x918ad58816c6d09137eB4075c2BA5c3e56aC4f6a
VITE_DEPLOY_BLOCK=48200239
VITE_EXPLORER_URL=https://base-sepolia.blockscout.com

# Demo accounts from docs/evidence.md (public addresses)
VITE_SELLER_ADDRESS=0x66b9Cd34A3D306Eb89F0d7FcF528A101D22D6B49
VITE_BUYER_ADDRESS=0xA9Cbb353E5Cb00413f3CD6BfaB3d11121245610F
VITE_UTILITY_ADDRESS=0xC25b2acf83FaE9434Ecf09FF7C692b786906450F
VITE_PLATFORM_ADDRESS=0xdd33958c0f6a2f647Bcc1Fd989305D4824541D15

# Impact factors (ASSUMPTIONS until you cite sources, see README "Impact method")
VITE_DIESEL_L_PER_KWH=0.3
VITE_CO2_KG_PER_L=2.68

# Mobile money (SIMULATED: no MoMo API is called, no real money moves)
# Simulated MoMo price in US$ per kWh (seller earns about 2x the grid tariff, shop pays about 1/3 less than a
# diesel generator) and the diesel price per litre in US$ for the "saved vs a generator" line. See src/lib/config.js.
# Demo energy scale: 1 Wh measured by the Wokwi meters = this many Wh at a real shop (prices use the real energy)
VITE_DEMO_ENERGY_SCALE=100
VITE_P2P_USD_PER_KWH=0.30
VITE_DIESEL_USD_PER_L=1.58
VITE_TRADE_MAX_WH=500
VITE_BUYER_MOMO="+233 24 ··· 1187"
VITE_SELLER_MOMO="+233 55 ··· 0420"
