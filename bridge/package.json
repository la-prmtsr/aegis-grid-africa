{
  "name": "aegis-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Aegis-Grid backend: v1 bridge (original meters) and v2 (Wokwi Stage 4E + Unity + dual-meter escrow).",
  "type": "module",
  "scripts": {
    "v2": "node src/v2/run.js",
    "v2:mock": "node src/v2/run.js --mock",
    "v2:testnet": "SETTLEMENT_MODE=testnet node src/v2/run.js",
    "v2:monitor": "node src/v2/run.js --monitor",
    "v2:setup": "node src/v2/setup.js",
    "v2:meter-a": "node src/v2/meter-a.js",
    "v2:meter-b": "node src/v2/meter-b.js",
    "v2:relayer": "node src/v2/relayer.js",
    "v2:mock-wokwi": "node src/v2/mock-wokwi.js",
    "adapter": "node src/aegis-unity/listen.mjs",
    "test": "node --test test/*.test.mjs",
    "listen": "node src/listen.js",
    "start": "node src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "mqtt": "^5.16.1"
  }
}
