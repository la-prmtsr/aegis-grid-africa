# Copy to .env and fill in. NEVER commit .env. Use throw-away TESTNET wallets only.

# --- network (Base Sepolia, chain id 84532; confirm in the Base docs)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=

# --- contract deployment (contracts/script/Deploy.s.sol)
UTILITY_ADDRESS=0x0000000000000000000000000000000000000000
PLATFORM_ADDRESS=0x0000000000000000000000000000000000000000

# --- MQTT (must match SITE in firmware/meter-*/sketch.ino)
MQTT_URL=mqtt://broker.hivemq.com:1883
SITE=ag-demo
TIME_SCALE=60

# ======================= v2: Wokwi Stage 4E + Unity (docs/integration-v2.md) =======================
# Wallet keys used by v2 (created in docs step 4b): DEPLOYER_PRIVATE_KEY (relayer gas), BUYER_PRIVATE_KEY
# (shop deposit), SELLER_PRIVATE_KEY (setup only), SELLER_METER_PRIVATE_KEY, BUYER_METER_PRIVATE_KEY,
# plus SELLER_ADDRESS and BUYER_ADDRESS. npm run v2 gives each process only its own key.

# contract v2 (5% battery reserve), printed by the deploy script
ESCROW_V2_ADDRESS=

AEGIS_SITE=ag-sakarya26
AEGIS_MQTT_URL=mqtt://broker.hivemq.com:1883
# energy accounting speed: 60 = one real second counts as one simulated minute (see "Time scale")
AEGIS_TIME_SCALE=60
AEGIS_LINE_LOSS=0.02
AEGIS_MIN_SOC_PCT=5
# Resident A's standing permission to sell (with a meter registered on-chain)
SELLER_CONSENT=true

# Wokwi REMOTE control (topics relative to aegis-grid/<site>/demo/control/). Leave empty until
# Faras confirms the format: the backend then only logs what it would send.
WOKWI_CTRL_BUYER_TOPIC=
WOKWI_CTRL_BUYER_ON=
WOKWI_CTRL_BUYER_OFF=
WOKWI_CTRL_OUTAGE_TOPIC=
WOKWI_CTRL_OUTAGE_ON=
WOKWI_CTRL_OUTAGE_OFF=
WOKWI_CTRL_BACKUP_TOPIC=
WOKWI_CTRL_BACKUP_ON=
WOKWI_CTRL_BACKUP_OFF=
# Sliders in the dashboard Control room: {value} is replaced by the watts, e.g. {"pv_power_w":{value}}
WOKWI_CTRL_PV_TOPIC=
WOKWI_CTRL_PV_VALUE=
WOKWI_CTRL_LOAD_TOPIC=
WOKWI_CTRL_LOAD_VALUE=
